{
  "family": "qwen",
  "model": {
    "model_path": "model/Qwen3-VL-4B-Instruct",
    "dtype": "bfloat16",
    "attn_implementation": "flash_attention_2",
    "output_mode": "embedding_adapter"
  },
  "train": {
    "teacher_deepstack": true,
    "data": "data/train/pixmo/pixmo_ama_full_valid.clean.jsonl",
    "image_root": "data/train/pixmo",
    "init_checkpoint": "",
    "max_steps": 2000,
    "save_every": 500,
    "log_every": 5,
    "seed": 44,
    "lr": 0.00005,
    "lr_scheduler": "cosine",
    "warmup_ratio": 0.03,
    "warmup_start_lr_ratio": 0.0,
    "min_lr_ratio": 0.1,
    "weight_decay": 0.01,
    "temperature": 2.0,
    "kl_topk": 1024,
    "lambda_logit": 1.0,
    "loss_normalization": "token",
    "supervision_loss": "distill",
    "visual_adapter_rank": 128,
    "required_world_size": 8,
    "micro_batch_size_per_gpu": 4,
    "gradient_accumulation_steps": 1,
    "distributed_engine": "deepspeed",
    "deepspeed_config": "configs/ds_zero2.json",
    "dist_backend": "nccl",
    "grad_clip": 1.0,
    "batch_sampling": "pixel_bucket",
    "pixel_bucket_size": 512,
    "pixel_area_cache": "data/train/pixmo/pixmo_ama_full_valid.clean.jsonl.pixel_areas.json",
    "wandb": true,
    "wandb_project": "vision-kv-inject",
    "wandb_mode": "online"
  }
}
