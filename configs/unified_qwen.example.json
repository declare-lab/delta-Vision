{
  "family": "qwen",
  "model": {
    "model_path": "/lustre-data/leijingdi/code/delta-vision/models/Qwen3-VL-4B-Instruct",
    "dtype": "bfloat16",
    "attn_implementation": "flash_attention_2",
    "output_mode": "embedding_adapter"
  },
  "train": {
    "data": "data/train/pixmo/pixmo_ama_full_valid.clean.jsonl",
    "image_root": "data/train/pixmo",
    "output_dir": "artifacts/experiments/unified_example/checkpoints",
    "visual_adapter_rank": 128,
    "supervision_loss": "distill",
    "loss_normalization": "token",
    "temperature": 2.0,
    "kl_topk": 1024,
    "lambda_logit": 2.0,
    "max_steps": 2000,
    "seed": 44
  },
  "eval": {
    "benchmark": "mmstar",
    "data": "data/benchmarks/mmstar/mmstar_val.jsonl",
    "data_root": "data/benchmarks/mmstar",
    "checkpoint": "artifacts/experiments/unified_example/checkpoints/qwen_embedding_adapter_step2000.pt",
    "output_dir": "artifacts/eval/unified_example/mmstar",
    "num_shards": 1,
    "shard_id": 0,
    "max_new_tokens": 8,
    "adapter_decode_cache_mode": "fast",
    "seed": 44
  }
}
